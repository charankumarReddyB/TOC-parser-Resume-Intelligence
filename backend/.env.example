# Backend Environment Configuration Template
# For local testing, SQLite is used by default:
DB_URL=sqlite:///./app.db

# For production deployment with PostgreSQL (Supabase/Neon/Render):
# DB_URL=postgresql://username:password@host:port/database

# Resend API Key (Optional, for sending candidate emails)
RESEND_API_KEY=
SMTP_EMAIL=onboarding@resend.dev
